BOT_TOKEN=123456789:replace_with_your_bot_token
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
MAX_CONCURRENT_DOWNLOADS=3
TELEGRAM_MAX_UPLOAD_MB=49
REQUEST_TIMEOUT_SECONDS=25

# Optional: only needed if you want to use Radio Javan's metadata API.
# The downloader still has public CDN/page fallbacks when these are empty.
RJ_API_KEY=
RJ_USER_AGENT=
